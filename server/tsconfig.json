{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "..",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../src/sync/protocol.ts"]
}
