# Copy to .env. Use a published version, or pin ghcr.io/<owner>/focus-session-server@sha256:<digest>.
# Image availability starts after the Server image workflow publishes the release tag.
FOCUS_SERVER_IMAGE=ghcr.io/xbghc/focus-session-server:0.3.5
POSTGRES_IMAGE=postgres:17-alpine

# Required: generate 32 random bytes as hex (openssl rand -hex 32); do not commit .env.
# Hex avoids percent-encoding special characters in the database connection URL.
POSTGRES_PASSWORD=

# Default: local reverse proxy only. Set a specific LAN address for a trusted LAN/VPN.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8787

# Comma-separated exact browser origins, without paths or trailing slashes.
# Add chrome-extension://<your-extension-id> if needed for your browser installation.
CORS_ORIGINS=https://appassets.androidplatform.net

# Request/file limits in bytes. Defaults: 16 MiB JSON, 32 MiB per file, 2 GiB per user.
MAX_JSON_BYTES=16777216
MAX_BLOB_BYTES=33554432
MAX_USER_BLOB_BYTES=2147483648
