<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 深色：Android 13+ 的 WebView 会照着 isLightTheme 决定 prefers-color-scheme，网页那边的暗色 token 随之生效 -->
    <style name="Theme.FocusSession" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
